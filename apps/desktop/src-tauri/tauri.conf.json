{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoPilot",
  "version": "0.6.0",
  "identifier": "com.echopilot.EchoPilot",
  "build": {
    "beforeBuildCommand": "cd ../web && npm run build",
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "EchoPilot",
        "width": 1360,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
